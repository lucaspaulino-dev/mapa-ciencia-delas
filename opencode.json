{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "ask",
      "eslint.config.ts": "deny",
      ".oxlintrc.json": "deny",
      "docs/regras-de-negocio.md": "deny"
    },
    "bash": {
      "*": "ask",
      "npm run *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git push*": "deny",
      "rm -rf*": "deny"
    },
    "webfetch": "ask"
  }
}
